{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Longbow",
  "version": "1.2.0",
  "identifier": "dev.cullenwerks.longbow",
  "build": {
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Longbow",
        "width": 1400,
        "height": 850,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": ["resources/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDMzFDQ0E2N0I4RUU4OTIKUldTUzZJNTdwc3d4ekllSXBiYWVNRjBGNVo5ejd1Qm1SbHVNNlJoVDVDZkpLUmFRUlQ3bERQQk0K",
      "endpoints": [
        "https://github.com/cullenwerks/longbow/releases/latest/download/latest.json"
      ]
    }
  }
}
